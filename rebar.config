%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_citizens.
%%
%% The citizens directory for the Macula mesh: who exists, federated across instances by mesh facts
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; mcl_om:boot/1 does the wiring before start/1.
    %% 0.33: calls sealed end to end under macula 13 (a capability call hands
    %% macula the provider's verified advertisement).
    %% 0.38: the release on macula 14 (mcl-citizens#2); 0.39 serves /health on
    %% the Unix socket config/sys.config.src names.
    %% 1.0: the macula-15 line (wire 1.0). The major moves with the wire so no
    %% `~> 0.x' service floats onto macula 15 by itself (mcl-om#27).
    {mcl_om, "~> 1.0"},
    %% Called directly (macula_topic, macula_node_keys, macula:subscribe/4).
    %% 15.6 is the wire 1.0 SDK base: subscribe now returns once a station
    %% acknowledges it (macula#12), which hear_citizen_presence already treats
    %% as any other refusal, by warning and rescheduling.
    {macula, "~> 15.6"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula reaches this app only through mcl_om, so rebar3 leaves it out of the
%% PLT and dialyzer cannot check the macula_response callbacks the responders
%% implement. Name it, so the behaviour is checked rather than excused.
{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [macula, mcl_om]}
]}.

{relx, [
    {release, {mcl_citizens, "0.4.0"}, [mcl_citizens, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
