{application, mcl_citizens, [
    {description, "The citizens directory for the Macula mesh: who exists, federated across instances by mesh facts"},
    {vsn, "0.3.1"},
    {registered, [mcl_citizens_sup]},
    {mod, {mcl_citizens_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Called directly: fact topics, node ids, the presence subscription.
        macula,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-citizens"}]}
]}.
